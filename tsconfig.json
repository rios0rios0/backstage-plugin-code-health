{
  "extends": "@backstage/cli/config/tsconfig.json",
  // One type-check pass for the whole workspace, matching how Backstage monorepos
  // are laid out: a single root `tsconfig.json` covering every package, whose
  // `dist-types` output is what `backstage-cli package build` reads back.
  "include": [
    "plugins/*/src",
    "plugins/*/test",
    "plugins/*/dev",
    "plugins/*/config.d.ts"
  ],
  "exclude": ["node_modules", "**/dist", "dist-types"],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/tsconfig.tsbuildinfo",
    // The automatic runtime, matching what the Backstage plugin templates and
    // the esbuild step in `backstage-cli package build` expect.
    "jsx": "react-jsx"
  }
}

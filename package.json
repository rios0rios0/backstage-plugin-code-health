{
  "name": "@rios0rios0/backstage-plugin-gitforge-dashboard",
  "version": "0.3.0",
  "description": "Backstage frontend plugin that shows CI status, releases, tags, compliance checks and contributor metrics for GitHub and Azure DevOps repositories",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config.d.ts",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "gitforge-dashboard",
    "pluginPackages": [
      "@rios0rios0/backstage-plugin-gitforge-dashboard"
    ]
  },
  "configSchema": "config.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rios0rios0/gitforge-dashboard.git"
  },
  "homepage": "https://github.com/rios0rios0/gitforge-dashboard#readme",
  "bugs": "https://github.com/rios0rios0/gitforge-dashboard/issues",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "github",
    "azure-devops",
    "sonarcloud",
    "wakatime",
    "ci"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist",
    "lint": "eslint src --fix",
    "lint:ci": "eslint src",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@backstage/core-components": "^0.18.12",
    "@backstage/core-plugin-api": "^1.12.8",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@tanstack/react-table": "^8.21.3"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.30.2"
  },
  "devDependencies": {
    "@backstage/test-utils": "^1.7.20",
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  }
}

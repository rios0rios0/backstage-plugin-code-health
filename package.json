{
  "name": "@rios0rios0/backstage-plugin-code-health",
  "version": "0.3.0",
  "description": "Backstage frontend plugin that shows CI status, releases, tags, compliance checks and contributor metrics for every GitHub and Azure DevOps repository",
  "license": "MIT",
  "packageManager": "yarn@4.12.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "config.d.ts",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "code-health",
    "pluginPackages": [
      "@rios0rios0/backstage-plugin-code-health"
    ]
  },
  "configSchema": "config.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rios0rios0/code-health.git"
  },
  "homepage": "https://github.com/rios0rios0/code-health#readme",
  "bugs": "https://github.com/rios0rios0/code-health/issues",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "code-health",
    "github",
    "azure-devops",
    "sonarcloud",
    "wakatime",
    "ci"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "tsc && backstage-cli package build",
    "typecheck": "tsc",
    "clean": "backstage-cli package clean && rm -rf dist-types",
    "lint": "backstage-cli package lint --fix",
    "lint:ci": "backstage-cli package lint",
    "test": "backstage-cli package test --watch=false",
    "test:ci": "backstage-cli package test --watch=false --coverage --reporters=default --reporters=jest-junit",
    "test:watch": "backstage-cli package test",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/core-components": "^0.18.12",
    "@backstage/core-plugin-api": "^1.12.8",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@tanstack/react-table": "^8.21.3"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^7.0.0"
  },
  "//resolutions": "Patched versions of transitive build-tooling dependencies carrying published advisories. Every target is the version GitHub records as the first patched release for the advisory in question.",
  "resolutions": {
    "brace-expansion@npm:^1.1.7": "^1.1.16",
    "brace-expansion@npm:^5.0.2": "^5.0.8",
    "brace-expansion@npm:^5.0.5": "^5.0.8",
    "tar@npm:^7.5.4": "^7.5.19",
    "tar@npm:^7.5.6": "^7.5.19",
    "fast-uri@npm:^3.0.1": "^3.1.4",
    "adm-zip@npm:0.5.10": "^0.6.0",
    "prismjs@npm:~1.27.0": "^1.30.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.4",
    "@backstage/cli-defaults": "^0.1.4",
    "@backstage/test-utils": "^1.7.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
    "jest-junit": "^16.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0",
    "typescript": "~5.9.3"
  },
  "jest": {
    "roots": [
      "<rootDir>",
      "<rootDir>/../test"
    ],
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!setupTests.ts",
      "!domain/entities/repository.ts",
      "!domain/entities/contributor.ts",
      "!domain/entities/release.ts",
      "!domain/entities/tag.ts",
      "!domain/entities/workflow_status.ts",
      "!domain/entities/sonar_metrics.ts",
      "!domain/repositories/**",
      "!domain/services/**",
      "!service/mappers/*_node.ts",
      "!index.ts",
      "!plugin.ts",
      "!routes.ts",
      "!main/api_refs.ts",
      "!main/apis.ts",
      "!main/router.tsx",
      "!infrastructure/crypto/crypto_key_store.ts"
    ],
    "coverageReporters": [
      "text",
      "json",
      "json-summary",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "functions": 90,
        "branches": 77,
        "statements": 90
      }
    }
  },
  "jest-junit": {
    "outputName": "junit-report.xml"
  }
}
